# WordPress Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change_me
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=

# WordPress Authentication Keys and Salts
# Get from: https://api.wordpress.org/secret-key/1.1/salt/

# WordPress
WP_ENV=production
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
WP_CRON_LOCK_TIMEOUT=120
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M

# Admin
WP_ADMIN_USER=admin
WP_ADMIN_PASS=change_me
WP_ADMIN_EMAIL=admin@example.com

# Site
WP_HOME=https://yoursite.com
WP_SITEURL=https://yoursite.com

# Future API Keys
YOUTUBE_API_KEY=
NEWS_API_KEY=
